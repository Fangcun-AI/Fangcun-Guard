# FangcunGuard Configuration
# Copy to .env and edit:  cp .env.example .env

# ============================================
# Detection Model (REQUIRED — the only thing you must change)
# ============================================
# Point to any OpenAI-compatible API (vLLM, OpenAI, Ollama, etc.)
GUARDRAILS_MODEL_API_URL=your_model_api_url
GUARDRAILS_MODEL_API_KEY=your_api_key
GUARDRAILS_MODEL_NAME=your_model_name

# ============================================
# Security (change in production)
# ============================================
SUPER_ADMIN_USERNAME=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=CHANGE-THIS-PASSWORD-IN-PRODUCTION
JWT_SECRET_KEY=your-secret-key-change-in-production
POSTGRES_PASSWORD=your_password

# ============================================
# Optional — defaults work out of the box
# ============================================

# Embedding model (for knowledge base)
# EMBEDDING_API_BASE_URL=http://YOUR_MODEL_SERVER:58004/v1
# EMBEDDING_API_KEY=EMPTY
# EMBEDDING_MODEL_NAME=bge-m3

# Vision-language model
# GUARDRAILS_VL_MODEL_API_URL=http://YOUR_MODEL_SERVER:58003/v1
# GUARDRAILS_VL_MODEL_API_KEY=EMPTY
# GUARDRAILS_VL_MODEL_NAME=Qwen3Guard-VL

# General-purpose LLM (for anonymization, regex generation, etc.)
# GENERAL_LLM_API_URL=http://YOUR_MODEL_SERVER:58008/v1
# GENERAL_LLM_API_KEY=EMPTY
# GENERAL_LLM_MODEL_NAME=Qwen/Qwen3-8B

# Language: en | zh (determines built-in scanner language)
# DEFAULT_LANGUAGE=en

# Deployment mode: enterprise | saas
# DEPLOYMENT_MODE=enterprise

# Service ports (defaults: 3000, 5000, 5001, 5002)
# FRONTEND_PORT=3000
# ADMIN_PORT=5000
# DETECTION_PORT=5001
# PROXY_PORT=5002

# Worker counts (tune for your hardware)
# ADMIN_UVICORN_WORKERS=2
# DETECTION_UVICORN_WORKERS=32
# PROXY_UVICORN_WORKERS=24

# CORS (add your domain in production)
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# SMTP (for email notifications)
# SMTP_SERVER=smtp.yourdomain.com
# SMTP_PORT=465
# SMTP_USERNAME=your-email@yourdomain.com
# SMTP_PASSWORD=your-password

# Guard Model Router — per-model API credentials
# Only configure models you want to use; unconfigured ones are auto-skipped.
# See docs/features/GUARD_MODEL_ROUTER.md for details.
# GUARD_MODELS_CONFIG_PATH=guard_models.yaml
# LLAMA_GUARD_API_URL=
# LLAMA_GUARD_API_KEY=
# LLAMA_GUARD_MODEL_NAME=
# PROMPT_GUARD_API_URL=
# PROMPT_GUARD_API_KEY=
# PROMPT_GUARD_MODEL_NAME=
# (full list: WILDGUARD, TOXIC_BERT, GLINER_PII, VECTARA_HHEM,
#  CODESHIELD, SHIELDGEMMA, GUARD_AGENT, AEGIS, AZURE_CONTENT_SAFETY,
#  OPENAI_MODERATION, PATRONUS, GUARD_06B — each with _API_URL, _API_KEY, _MODEL_NAME)
