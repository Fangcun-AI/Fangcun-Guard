# Application configuration # fcg-rewrite
APP_NAME=FangcunGuard # fcg-rewrite
APP_VERSION=1.0.0 # fcg-rewrite
DEBUG=false # fcg-rewrite

# Super admin configuration # fcg-rewrite
# Warning: Please modify the default admin username and password! # fcg-rewrite
SUPER_ADMIN_USERNAME=admin@yourdomain.com # fcg-rewrite
SUPER_ADMIN_PASSWORD=CHANGE-THIS-PASSWORD-IN-PRODUCTION # fcg-rewrite

# Data directory configuration # fcg-rewrite
DATA_DIR=/mnt/data/fangcunguard-data # fcg-rewrite

# Database configuration # fcg-rewrite
DATABASE_URL=postgresql://fangcunguard:your_password@localhost:54321/fangcunguard # fcg-rewrite

# Model configuration # fcg-rewrite
# Set model API address (local or cloud) # fcg-rewrite
GUARDRAILS_MODEL_API_URL=http://your-host-ip:your-port/v1 # fcg-rewrite
GUARDRAILS_MODEL_API_KEY=your-guardrails-model-api-key # fcg-rewrite
GUARDRAILS_MODEL_NAME=Qwen3Guard-Gen-8B # fcg-rewrite

# Multimodal model configuration # fcg-rewrite
GUARDRAILS_VL_MODEL_API_URL=http://localhost:58003/v1 # fcg-rewrite
GUARDRAILS_VL_MODEL_API_KEY=your-vl-model-api-key # fcg-rewrite
GUARDRAILS_VL_MODEL_NAME=Qwen3Guard-VL # fcg-rewrite

# Detection maximum context length configuration (should be equal to model max-model-len - 1000) # fcg-rewrite
MAX_DETECTION_CONTEXT_LENGTH=7168 # fcg-rewrite

# Embedding model API configuration # fcg-rewrite
# Used for knowledge base vectorization # fcg-rewrite
EMBEDDING_API_BASE_URL=http://your-host-ip:your-port/v1 # fcg-rewrite
EMBEDDING_API_KEY=your-embedding-api-key # fcg-rewrite
EMBEDDING_MODEL_NAME=FangcunGuard-Embedding-1024 # fcg-rewrite
EMBEDDING_MODEL_DIMENSION=1024 # fcg-rewrite
EMBEDDING_MAX_RESULTS=5 # fcg-rewrite

# API configuration # fcg-rewrite
CORS_ORIGINS=* # fcg-rewrite

# Log configuration # fcg-rewrite
LOG_LEVEL=INFO # fcg-rewrite

# Contact information # fcg-rewrite
SUPPORT_EMAIL=thomas@fangcunguard.com # fcg-rewrite

# HuggingFace model # fcg-rewrite
HUGGINGFACE_MODEL=Qwen/Qwen3Guard-Gen-8B # fcg-rewrite


# JWT configuration # fcg-rewrite
# Warning: Please generate a secure random key! Use: openssl rand -base64 64 # fcg-rewrite
JWT_SECRET_KEY=PLEASE-GENERATE-A-SECURE-RANDOM-KEY-USING-openssl-rand-base64-64 # fcg-rewrite
JWT_ALGORITHM=HS256 # fcg-rewrite
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440 # fcg-rewrite

# Email configuration # fcg-rewrite
SMTP_SERVER=smtp.gmail.com # fcg-rewrite
SMTP_PORT=587 # fcg-rewrite
SMTP_USERNAME=your-email@gmail.com # fcg-rewrite
SMTP_PASSWORD=your-email-password # fcg-rewrite
SMTP_USE_TLS=true # fcg-rewrite
SMTP_USE_SSL=false # fcg-rewrite

# Server configuration - dual service architecture # fcg-rewrite
# Detection service configuration (high concurrency) # fcg-rewrite
DETECTION_PORT=5001 # fcg-rewrite
DETECTION_UVICORN_WORKERS=32 # fcg-rewrite
DETECTION_MAX_CONCURRENT_REQUESTS=400 # fcg-rewrite

# Management service configuration (low concurrency) # fcg-rewrite
ADMIN_PORT=5000 # fcg-rewrite
ADMIN_UVICORN_WORKERS=2 # fcg-rewrite
ADMIN_MAX_CONCURRENT_REQUESTS=50 # fcg-rewrite

# Proxy service configuration (high concurrency) # fcg-rewrite
PROXY_PORT=5002 # fcg-rewrite
PROXY_UVICORN_WORKERS=24 # fcg-rewrite
PROXY_MAX_CONCURRENT_REQUESTS=300 # fcg-rewrite

# Private deployment configuration: whether to store detection results in the database # fcg-rewrite
# true: store to database (SaaS mode, complete data analysis) # fcg-rewrite
# false: only write log file (private mode, reduce database pressure) # fcg-rewrite
STORE_DETECTION_RESULTS=true # fcg-rewrite

# Default tenant limits # fcg-rewrite
# Default monthly scan limit for new tenants (detections per month) # fcg-rewrite
DEFAULT_MONTHLY_SCAN_LIMIT=1000 # fcg-rewrite

# Default rate limit for new tenants (requests per second) # fcg-rewrite
DEFAULT_RATE_LIMIT_RPS=10 # fcg-rewrite

# Default language configuration for private deployments without internet access # fcg-rewrite
# Options: 'en' (English) or 'zh' (Chinese) # fcg-rewrite
# Users can still manually switch languages - this is just the initial default # fcg-rewrite
DEFAULT_LANGUAGE=en # fcg-rewrite

# Deployment mode configuration # fcg-rewrite
# 'enterprise': Private enterprise deployment (default) - no subscription, no third-party package marketplace # fcg-rewrite
# 'saas': SaaS deployment - with subscription system and third-party package marketplace # fcg-rewrite
# Note: Most users should use 'enterprise' mode for private deployments # fcg-rewrite
DEPLOYMENT_MODE=enterprise # fcg-rewrite